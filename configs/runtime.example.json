{
  "providers": {
    "gateway": {
      "base_url": "https://gateway.example.com/v1",
      "chat_completions_path": "/chat/completions",
      "max_output_tokens_field": "max_tokens",
      "keys": [
        {
          "key_id": "default",
          "api_key_env": "TRACECAST_LLM_API_KEY",
          "max_concurrency": 8
        }
      ]
    }
  },
  "routes": {
    "atom_boundary_dsl": {
      "stage": "atomizer",
      "provider": "gateway",
      "model": "your-standard-model",
      "system_prompt": "prompt/ingestion/atom_boundary_dsl.system.{locale}.md",
      "user_prompt": "prompt/ingestion/atom_boundary_dsl.user.{locale}.md",
      "repair_prompt": "prompt/ingestion/atom_boundary_dsl.repair.{locale}.md",
      "temperature": 0,
      "max_output_tokens": 40960,
      "timeout_seconds": 180,
      "max_concurrency": 8,
      "transport_max_attempts": 3,
      "transport_backoff_base_seconds": 1.0,
      "transport_backoff_max_seconds": 30.0,
      "transport_jitter_ratio": 0.25
    },
    "source_profile_probe": {
      "stage": "intake",
